rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ Custom claims 검증 함수 (Cloud Functions로 설정됨)
    function hasCoupleIdAccess(coupleId) {
      return request.auth != null &&
        request.auth.token.coupleIds != null &&
        coupleId in request.auth.token.coupleIds;
    }

    // 이벤트 이미지: 경로 events/{coupleId}/{eventId}/{filename}
    // ✅ coupleId custom claim 검증 필수
    match /events/{coupleId}/{eventId}/{filename} {
      allow read: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
      allow create, update: if request.auth != null &&
        hasCoupleIdAccess(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      // 삭제는 request.resource가 없어(null) size/contentType 검증이 불가능 — 별도 규칙으로 분리
      allow delete: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
    }

    // 커플 hero 이미지: 경로 couples/{coupleId}/hero
    // ✅ coupleId custom claim 검증 필수
    match /couples/{coupleId}/hero {
      allow read: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
      allow create, update: if request.auth != null &&
        hasCoupleIdAccess(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      // 삭제는 request.resource가 없어(null) size/contentType 검증이 불가능 — 별도 규칙으로 분리.
      // 예전엔 allow write 하나로 합쳐져 있어서 홈 사진 "제거"가 항상 거부됐음(2026-10-12 발견/수정)
      allow delete: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
    }

    // 봉인 편지 첨부 이미지: 경로 sealedMessages/{coupleId}/{messageId}_{임의값} (v1.1.8~, 예전 편지는 _{임의값} 없음)
    // ✅ coupleId custom claim 검증 필수 — 편지 내용의 열람 제한(봉인 여부)은 Firestore 쪽에서 처리하고,
    // 이미지 파일 자체는 같은 커플이면 읽을 수 있음. 파일 이름의 임의값은 private/content(봉인 중엔 작성자만 읽음)에만
    // 있어 받는 사람이 경로를 추측할 수 없음(예전 고정 경로는 편지 ID만 알면 받아볼 수 있었음 — AUDIT S-3)
    match /sealedMessages/{coupleId}/{messageId} {
      allow read: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
      allow create, update: if request.auth != null &&
        hasCoupleIdAccess(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      // 삭제는 request.resource가 없어(null) size/contentType 검증이 불가능 — 별도 규칙으로 분리
      allow delete: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
    }

    // 기본: 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
