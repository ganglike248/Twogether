rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ Custom claims 검증 함수 (Cloud Functions로 설정됨)
    function hasCoupleIdAccess(coupleId) {
      return request.auth != null &&
        request.auth.token.coupleIds != null &&
        coupleId in request.auth.token.coupleIds;
    }

    // 이벤트 이미지: 경로 events/{coupleId}/{eventId}/{filename}
    // ✅ coupleId custom claim 검증 필수
    match /events/{coupleId}/{eventId}/{filename} {
      allow read: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
      allow write: if request.auth != null &&
        hasCoupleIdAccess(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 커플 hero 이미지: 경로 couples/{coupleId}/hero
    // ✅ coupleId custom claim 검증 필수
    match /couples/{coupleId}/hero {
      allow read: if request.auth != null &&
        hasCoupleIdAccess(coupleId);
      allow write: if request.auth != null &&
        hasCoupleIdAccess(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 기본: 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
