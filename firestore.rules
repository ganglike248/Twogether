rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 요청자가 해당 커플의 멤버인지 확인
    function isCoupleMe(coupleId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // users: 본인만 쓰기, 같은 커플 멤버는 읽기 가능
    match /users/{userId} {
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId != null &&
          userId in get(/databases/$(database)/documents/couples/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId)).data.members
        )
      );
    }

    // inviteCodes: 초대 코드 → coupleId 매핑 (초대 코드 조회 전용)
    // couples 컬렉션을 누구나 읽는 대신 이 컬렉션으로 분리해 커플 데이터 노출 최소화
    // ⚠ 2026-08-25 보안 감사: allow read가 필드 조건 없이 열려있으면 list()로 컬렉션 전체
    // (coupleId, joined 여부 포함)를 누구나 열람할 수 있어서 get/list를 분리함 — 앱은 항상
    // 정확한 코드로 단건 조회(get)만 하고 목록 조회는 쓰지 않으므로 list는 완전히 차단.
    match /inviteCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated();
      // joined 갱신(합류 처리)은 반드시 joinCoupleWithInviteCode Cloud Function(Admin SDK)을
      // 거쳐야 함 — 클라이언트 직접 쓰기를 허용하면 초대 코드 검증 없이도 갱신 시도가 가능해짐.
      allow update: if false;
      allow delete: if false;
    }

    // couples: 멤버만 읽기/쓰기 가능. 새 멤버 합류는 이 규칙으로 처리하지 않음 —
    // ⚠ 2026-08-25 보안 감사: 예전엔 "멤버 1명짜리 커플이면 누구든 자기 uid를 추가 가능"
    // 분기가 있었는데 초대 코드 검증이 전혀 없어서, coupleId만 알면 아무나 파트너를 기다리는
    // 커플에 무단으로 합류할 수 있는 취약점이었음. 합류는 초대 코드를 서버에서 검증하는
    // joinCoupleWithInviteCode Cloud Function(Admin SDK, 규칙 우회)로만 가능하도록 변경.
    match /couples/{coupleId} {
      allow read: if isCoupleMe(coupleId);
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members;
    }

    // events: 커플 공유 이벤트 (필수 필드 검증)
    // 'personal' 타입은 이 컬렉션에 존재하지 않음 — personal_events 컬렉션에 별도 저장
    match /events/{docId} {
      function isValidEvent() {
        return request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.start is string &&
          request.resource.data.start.size() > 0 &&
          request.resource.data.eventType is string &&
          request.resource.data.eventType in ['couple', 'boyfriend', 'girlfriend', 'travel'];
      }

      allow read: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow delete: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId) &&
        isValidEvent();
      allow update: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId) &&
        request.resource.data.coupleId == resource.data.coupleId &&
        isValidEvent();
    }

    // 반복 일정 규칙 원본 (v0.4.35~): 인스턴스는 events/personal_events에 개별 문서로 그대로
    // 저장되고(recurrence.seriesId로 이 문서를 참조), 이 문서는 규칙 기록 + 알림 트리거 앵커 역할만 함
    match /eventSeries/{seriesId} {
      function isSeriesOwner(data) {
        return data.isPersonal == true
          ? request.auth.uid == data.userId
          : isCoupleMe(data.coupleId);
      }
      function isValidSeries() {
        return request.resource.data.freq in ['daily', 'weekly', 'monthly', 'yearly'] &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0;
      }

      allow read: if isAuthenticated() && isSeriesOwner(resource.data);
      allow create: if isAuthenticated() &&
        isSeriesOwner(request.resource.data) &&
        isValidSeries();
      allow update: if isAuthenticated() &&
        isSeriesOwner(resource.data) &&
        request.resource.data.coupleId == resource.data.coupleId &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && isSeriesOwner(resource.data);
    }

    match /edit_logs/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.coupleId == null ||
        isCoupleMe(resource.data.coupleId)
      );
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId);
      allow update: if false;
      allow delete: if false;
    }

    // trips: 여행 데이터 (필수 필드 검증)
    match /trips/{docId} {
      function isValidTrip() {
        return request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.startDate != null &&
          request.resource.data.endDate != null;
      }

      allow read: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow delete: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId) &&
        isValidTrip();
      allow update: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId) &&
        request.resource.data.coupleId == resource.data.coupleId &&
        isValidTrip();
    }

    match /tripSchedules/{docId} {
      allow read, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.coupleId);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.coupleId);
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.coupleId) &&
        request.resource.data.tripId == resource.data.tripId;
    }

    match /travelTimes/{docId} {
      allow read, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.coupleId);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.coupleId);
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.coupleId) &&
        request.resource.data.tripId == resource.data.tripId;
    }

    // bucketlists: 버킷리스트 (필수 필드 검증)
    match /bucketlists/{docId} {
      function isValidBucket() {
        return request.resource.data.title is string &&
          request.resource.data.title.size() > 0;
      }

      allow read: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow delete: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId) &&
        isValidBucket();
      allow update: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId) &&
        request.resource.data.coupleId == resource.data.coupleId &&
        isValidBucket();
    }

    match /cycles/{docId} {
      allow read, delete: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId);
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId);
      allow update: if isAuthenticated() &&
        isCoupleMe(resource.data.coupleId) &&
        request.resource.data.coupleId == resource.data.coupleId;
    }

    // 개인 캘린더: 소유자만 접근 가능
    match /personal_events/{docId} {
      allow read, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId;
    }

    // 여행 선택지 (v0.3.51): 커플 멤버만 접근 가능
    match /trips/{tripId}/travelDecisions/{decisionId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
    }

    // 여행 체크리스트 (v0.3.51): 커플 멤버만 접근 가능
    match /trips/{tripId}/checklists/{checklistId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
      allow delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        isCoupleMe(get(/databases/$(database)/documents/trips/$(tripId)).data.coupleId);
    }

    // 봉인 편지함 (v0.4.22): 존재 여부(제목/예정시각/봉인상태)는 커플 둘 다 항상 읽기 가능하지만,
    // 실제 내용(content/imageUrl)은 private 서브컬렉션으로 분리해서 봉인 중엔 진짜로 안 보이게 함
    // (문서 단위로만 read를 막을 수 있는 Firestore 규칙 특성상, 같은 문서에 두면 봉인 중에도
    // 클라이언트가 직접 조회 시 다 보이는 허점이 생김).
    match /sealedMessages/{messageId} {
      allow read: if isAuthenticated() && isCoupleMe(resource.data.coupleId);
      allow create: if isAuthenticated() &&
        isCoupleMe(request.resource.data.coupleId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.isUnlocked == false &&
        request.resource.data.recipientUid in
          get(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.members;
      // 작성자만, 아직 안 열린 편지만 수정 가능 (예약시각 변경 또는 직접 공개 처리)
      allow update: if isAuthenticated() &&
        resource.data.authorUid == request.auth.uid &&
        resource.data.isUnlocked == false;
      // 작성자는 언제든(봉인 중이든 공개됐든) 삭제 가능 — private/content를 먼저 지운 뒤 이 문서를 지울 것
      // (content 삭제 규칙이 이 문서를 get()으로 조회해 작성자를 확인하므로 순서가 바뀌면 실패함)
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;

      match /private/content {
        allow read: if isAuthenticated() &&
          isCoupleMe(get(/databases/$(database)/documents/sealedMessages/$(messageId)).data.coupleId) &&
          (
            get(/databases/$(database)/documents/sealedMessages/$(messageId)).data.isUnlocked == true ||
            get(/databases/$(database)/documents/sealedMessages/$(messageId)).data.authorUid == request.auth.uid
          );
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/sealedMessages/$(messageId)).data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/sealedMessages/$(messageId)).data.authorUid == request.auth.uid;
      }
    }
  }
}
